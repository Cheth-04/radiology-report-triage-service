# LOCAL DEVELOPMENT ONLY. Replace passwords and secrets before any real deployment.
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=triage_db
DATABASE_URL=postgresql+psycopg://triage:change-this-local-password@db:5432/triage_db
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# On Docker Desktop (Mac/Windows), this resolves to the host computer.
LLM_BASE_URL=http://host.docker.internal:1234/v1
# Set this to the exact ID shown at GET /v1/models before running extraction.
LLM_MODEL=replace-with-loaded-model-id
LLM_API_KEY=lm-studio
# Required for JWT authentication in Step 3. Generate a strong value before use.
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
