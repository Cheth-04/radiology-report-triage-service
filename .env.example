
# PostgreSQL
POSTGRES_USER=triage
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=triage_db
DATABASE_URL=postgresql+psycopg://triage:change-this-local-password@db:5432/triage_db

# Redis and Celery
REDIS_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# LLM Configuration
# mock = works without LM Studio
# lmstudio = uses the local LLM
LLM_MODE=mock
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_MODEL=replace-with-loaded-model-id
LLM_API_KEY=lm-studio
LLM_TIMEOUT_SECONDS=90

# JWT Authentication
JWT_SECRET=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
